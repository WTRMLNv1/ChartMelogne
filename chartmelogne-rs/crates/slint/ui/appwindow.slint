import { ChartWidget, PriceTickUi, TimeTickUi } from "chart_widget.slint";
export { PriceTickUi, TimeTickUi }

export component AppWindow inherits Window {
    title: "ChartMelogne - Rust + wgpu 30";
    min-width: 900px;
    min-height: 550px;
    default-font-family: "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif";
    background: #131722;

    // Viewport image & dimensions (aliased to inner ChartWidget)
    in-out property <image> chart_texture <=> chart.chart_texture;
    in-out property <length> plot_width <=> chart.plot_width;
    in-out property <length> plot_height <=> chart.plot_height;

    // Axis Ticks
    in-out property <[PriceTickUi]> price_ticks <=> chart.price_ticks;
    in-out property <[TimeTickUi]> time_ticks <=> chart.time_ticks;

    // Crosshair State
    in-out property <bool> crosshair_active <=> chart.crosshair_active;
    in-out property <length> crosshair_x <=> chart.crosshair_x;
    in-out property <length> crosshair_y <=> chart.crosshair_y;
    in-out property <length> crosshair_snapped_x <=> chart.crosshair_snapped_x;
    in-out property <string> crosshair_price <=> chart.crosshair_price;
    in-out property <string> crosshair_time <=> chart.crosshair_time;

    // Last Price
    in-out property <bool> last_price_visible <=> chart.last_price_visible;
    in-out property <length> last_price_y <=> chart.last_price_y;
    in-out property <string> last_price_str <=> chart.last_price_str;
    in-out property <color> last_price_color <=> chart.last_price_color;

    // Auto / Manual Y Mode
    in-out property <bool> auto_y_mode <=> chart.auto_y_mode;

    // Top-Left HUD (OHLCV)
    in-out property <bool> hud_active <=> chart.hud_active;
    in-out property <string> hud_open <=> chart.hud_open;
    in-out property <string> hud_high <=> chart.hud_high;
    in-out property <string> hud_low <=> chart.hud_low;
    in-out property <string> hud_close <=> chart.hud_close;
    in-out property <string> hud_volume <=> chart.hud_volume;
    in-out property <color> hud_ohlc_color <=> chart.hud_ohlc_color;

    // Chart Flags & Optional Features
    in-out property <bool> allow_zoom <=> chart.allow_zoom;
    in-out property <bool> show_axes <=> chart.show_axes;
    in-out property <string> chart_type <=> chart.chart_type;
    in-out property <bool> show_volume <=> chart.show_volume;
    in-out property <bool> show_indicators <=> chart.show_indicators;
    in-out property <bool> menu_open <=> chart.menu_open;

    // Callbacks to Rust
    callback pointer_moved(length, length);
    callback pointer_left();
    callback drag_started(length, length);
    callback drag_ended();
    callback dragged(length, length);
    callback scrolled(length, length); // delta_y, cursor_x
    callback price_axis_scrolled(length, length); // delta_y, cursor_y
    callback toggle_auto_y();
    callback toggle_allow_zoom(bool);
    callback toggle_show_axes(bool);
    callback toggle_chart_type(string);
    callback toggle_show_volume(bool);
    callback toggle_show_indicators(bool);

    // Embedded ChartWidget filling the entire window
    chart := ChartWidget {
        width: 100%;
        height: 100%;

        pointer_moved(x, y) => { root.pointer_moved(x, y); }
        pointer_left() => { root.pointer_left(); }
        drag_started(x, y) => { root.drag_started(x, y); }
        drag_ended() => { root.drag_ended(); }
        dragged(x, y) => { root.dragged(x, y); }
        scrolled(dy, cx) => { root.scrolled(dy, cx); }
        price_axis_scrolled(dy, cy) => { root.price_axis_scrolled(dy, cy); }
        toggle_auto_y() => { root.toggle_auto_y(); }
        toggle_allow_zoom(val) => { root.toggle_allow_zoom(val); }
        toggle_show_axes(val) => { root.toggle_show_axes(val); }
        toggle_chart_type(val) => { root.toggle_chart_type(val); }
        toggle_show_volume(val) => { root.toggle_show_volume(val); }
        toggle_show_indicators(val) => { root.toggle_show_indicators(val); }
    }
}
